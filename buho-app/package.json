{
    "name": "buho-app",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "dev:nohmr": "NO_HMR=1 vite dev",
        "build": "vite build && node scripts/write-seo-files.mjs",
        "preview": "vite preview",
        "build:geo": "node scripts/build-geo-assets.mjs",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:headless": "vitest run --project headless",
        "test:watch": "vitest",
        "predev": "node scripts/fetch-duckdb-extensions.mjs",
        "prebuild": "node scripts/fetch-duckdb-extensions.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@lucide/svelte": "^1.77.0",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.4.0",
        "@sveltejs/load-config": "^0.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/svelte": "^5.4.2",
        "@types/d3": "^7.4.3",
        "@types/topojson-client": "^3.1.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "mapshaper": "^0.8.7",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.2.0",
        "svelte": "^5.59.1",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@deck.gl/core": "^9.4.1",
        "@deck.gl/layers": "^9.4.1",
        "@deck.gl/mapbox": "^9.4.1",
        "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@garmin/fitsdk": "^21.222.0",
        "d3": "^7.9.2",
        "gifenc": "^1.0.3",
        "jszip": "^3.10.2",
        "maplibre-gl": "^6.19.0",
        "mediabunny": "^1.66.2",
        "topojson-client": "^3.1.0"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
